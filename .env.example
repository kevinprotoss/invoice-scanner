# ---------------------------------------------------------------------------
# Application server
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------------------------------------------------------------------
# Authentication
#
# APP_PASSWORD_HASH: PBKDF2 hash of the login password.
#   Generate with:  python scripts/make_password_hash.py
#   Format:         pbkdf2_sha256$<iterations>$<base64_salt>$<base64_hash>
#   NEVER use `python -c "..."` to generate this — the shell will expand `$`.
#
# APP_SECRET_KEY: HMAC key used to sign session cookies.
#   Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Changing it invalidates all existing sessions.
# ---------------------------------------------------------------------------
APP_PASSWORD_HASH=
APP_SECRET_KEY=

# 1 = cookie only sent over HTTPS (required when served over HTTPS)
# 0 = allow HTTP (local development only)
APP_COOKIE_SECURE=0

# Session lifetime in seconds (default: 7 days)
APP_SESSION_TTL=604800

# ---------------------------------------------------------------------------
# Storage
#
# APP_DATA_DIR is the invoice data root.
#   - Local dev (running python directly):  ./data
#   - Inside Docker container:              /data  (mounted from host)
#   - Inside devcontainer:                  /workspace/data
# ---------------------------------------------------------------------------
APP_DATA_DIR=./data

# Max size per uploaded file, in bytes (default: 30 MB)
APP_MAX_UPLOAD_BYTES=31457280

# Max images per invoice
APP_MAX_IMAGES_PER_INVOICE=20

# ---------------------------------------------------------------------------
# Anthropic / Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=16384

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
OCR_LANG=german
OCR_USE_GPU=0

# ---------------------------------------------------------------------------
# HTTPS (optional)
#
# Leave empty to serve plain HTTP (local dev).
# When serving over HTTPS with mkcert, set these to the container paths where
# the certs/ directory is mounted:
#   SSL_CERTFILE=/certs/localhost.pem
#   SSL_KEYFILE=/certs/localhost-key.pem
# and set APP_COOKIE_SECURE=1 above.
# ---------------------------------------------------------------------------
SSL_CERTFILE=
SSL_KEYFILE=